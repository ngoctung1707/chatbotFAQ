[Unit]
# Job cap nhat du lieu chatbot hang tuan — muc 6.1 va 6.5.
Description=BK Fintech chatbot — cap nhat chi muc hang tuan
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/hust/bkfintech/app
ExecStart=/usr/bin/env bash scripts/crawl/run-weekly.sh

# MUC 6.5 — tran RAM.
#
# 2G, VA CHU THICH BEN DUOI DA DUOC VIET LAI CHO DUNG SU THAT.
#
# Ban truoc ghi "3G = ~1,5-2G cho pha B (mot ban BGE-M3) cong bien an toan"
# nhung directive lai dat 4G — lech nhau tu dau, va ca hai con so deu tinh cho
# mot the gioi khong con nua: pha B TU NAP mot ban BGE-M3 trong tien trinh cua
# job. Bay gio no goi /api/chatbot/embed va muon ban model cua app, nen job
# KHONG BAO GIO nap model nua.
#
# Do duoc lai, dinh RSS cua pha nang nhat con lai (pha C — doc cache ~15MB,
# dung IDF, ghi store 19MB):
#
#   dinh RSS 371 MB | rss cuoi 317 MB
#
# 2G la ~5 lan con so do, du cho ca pha A (crawl) lan cac buoc phu, ma van du
# thap de cham tran la co chuyen that chu khong phai mot dot cao diem binh
# thuong.
#
# `--max-old-space-size` cua Node van KHONG thay the duoc dong nay: no chi gioi
# han heap cua V8. Dieu do van dung ngay ca khi job khong con nap model — mot
# tien trinh tsx bi ro ri ngoai heap thi V8 khong biet gi. Dat tran bang cgroup
# moi tinh ca hai.
#
# Cham tran thi job bi kill sach voi log ro rang, thay vi de OOM killer cua
# kernel tu chon nan nhan — ma no rat co the chon mot dich vu khac cua vien.
MemoryMax=2G
MemorySwapMax=0

# May chu dung chung: job nay khong duoc phep lam cham thu khac. Website van
# dang phuc vu suot pha A.
Nice=10
IOSchedulingClass=idle
CPUWeight=50

# Watchdog cua systemd, dat CAO HON tran 15 phut trong run-weekly.sh de hai co
# che khong tranh nhau: script tu don dep truoc, day chi la luoi cuoi.
TimeoutStartSec=25min

StandardOutput=append:/home/hust/bkfintech/app/data/weekly.log
StandardError=append:/home/hust/bkfintech/app/data/weekly.log

# Luoi cho truong hop bay EXIT trong script khong chay duoc: bi `kill -9`, OOM
# killer, hoac systemd tu cat vi qua TimeoutStartSec.
#
# ─── VI SAO KHONG CON `docker compose restart app` O DAY ─────────────────────
#
# ExecStopPost chay sau MOI lan unit ket thuc, ke ca thanh cong. Ma duong thanh
# cong thi bay EXIT da restart app roi — nen moi chu nhat website bi restart hai
# lan lien tiep, lan thu hai roi dung luc tien trinh moi dang nap model, vut bo
# cong nap do va bat ca site chop them mot nhip khong can thiet.
#
# Bo di khong mat gi, vi giay phep tu het han da lo phan phuc hoi: app dang chay
# o che do bo preload se tu tra loi binh thuong tro lai ngay khi han het, roi nap
# model lazily o cau hoi dau tien. Cham hon vai giay cho DUNG MOT cau hoi, doi lai
# khong con lan restart thua nao.
#
# Hai lenh `rm -f` thi giu: xoa giay phep rut phuc hoi tu 5 phut xuong tuc thi,
# va xoa lock la thu that su can — mot lock sot lai se chan MOI lan chay sau do.
# An toan vi KillMode mac dinh la control-group: systemd da giet ca nhom tien
# trinh (ke ca `tsx` con dang embed) TRUOC khi dong nay chay, nen "khong con giay
# phep" van dong nghia voi "khong con ai giu RAM".
ExecStopPost=/usr/bin/env bash -c 'rm -f data/maintenance.flag data/maintenance.flag.tmp data/.weekly.lock'

[Install]
WantedBy=multi-user.target
