PAYLOAD_SECRET=your-payload-secret
DATABASE_URI=mongodb://localhost:27017/bkft
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Chatbot (src/lib/chatbot/*, mounted at /api/chat) ---
# Runs in-process now — no separate FastAPI service, so CHATBOT_FAQ_URL is
# gone. Chat history reuses DATABASE_URI above; nothing extra needed there.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Optional overrides — all have sane defaults in src/lib/chatbot/config.ts:
# CHATBOT_MODEL=gemini-3.1-flash-lite
# CHATBOT_MOCK=1                # serve canned answers, no Gemini call needed
# CHATBOT_TRANSLATE=1
# CHATBOT_TOP_K=7
# CHATBOT_TIMEOUT_MS=10000
# CHATBOT_LOG_CHUNKS=1
# CHATBOT_CHUNKS_PATH=data/processed/chunks.json   # used by `npm run build-index`
# CHATBOT_INDEX_DIR=data/faiss_index_js