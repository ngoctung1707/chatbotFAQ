PAYLOAD_SECRET=your-payload-secret
DATABASE_URI=mongodb://localhost:27017/bkft
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Chatbot (src/lib/chatbot/*, mounted at /api/chat) ---
# Runs in-process now — no separate FastAPI service, so CHATBOT_FAQ_URL is
# gone. Chat history reuses DATABASE_URI above; nothing extra needed there.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Optional overrides — all have sane defaults in src/lib/chatbot/config.ts:
# CHATBOT_MODEL=gemini-3.5-flash-lite
# CHATBOT_MOCK=1                # serve canned answers, no Gemini call needed
# CHATBOT_TRANSLATE=1
# CHATBOT_TOP_K=7
# CHATBOT_TIMEOUT_MS=10000
# CHATBOT_LOG_CHUNKS=1
# CHATBOT_CHUNKS_PATH=data/processed/chunks.json   # used by `npm run build-index`
# CHATBOT_INDEX_DIR=data/faiss_index_js
# --- Job cập nhật hàng tuần mượn model của app (bắt buộc nếu chạy run-weekly.sh) ---
# Cùng một giá trị phải có ở .env của app VÀ ở môi trường chạy job. Thiếu ->
# /api/chatbot/embed và /api/chatbot/reload trả 503 (đóng chứ không mở).
# CHATBOT_INTERNAL_SECRET=doi-thanh-mot-chuoi-ngau-nhien-dai
# CHATBOT_APP_URL=http://localhost:3003   # job gọi vào đây (cổng ở compose.yaml)
#
# CHATBOT_EMBED_REMOTE — CHỈ đặt cho JOB, TUYỆT ĐỐI KHÔNG đặt trong .env của app.
# Có nó thì mọi script (embed.ts, qa-gate.ts, ...) mượn model của app thay vì tự
# nạp một bản BGE-M3 riêng. run-weekly.sh tự export biến này, nên bình thường
# không phải khai ở đây; chỉ cần khi chạy tay từng script.
# run-weekly.sh đặt sẵn = CHATBOT_APP_URL
#
# An toàn kể cả khi lỡ đặt nhầm: config.ts vô hiệu hoá nó khi NEXT_RUNTIME có
# giá trị, nên app không thể tự gọi chính nó thành vòng lặp.
# CHATBOT_EMBED_BATCH=16                  # số đoạn mỗi lượt gọi, trần phía app là 128
# CHATBOT_EMBED_TIMEOUT_MS=60000
# CHATBOT_EMBED_WORKER=/duong/dan/khac/embed-worker.mjs
